@model IEnumerable<HeirWebApp.Models.Member>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.role)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.contact)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.parentId)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.name)
            </td>
            <td>
                @Html.DisplayFor(model => item.role)
            </td>
            <td>
                @Html.DisplayFor(model => item.contact)
            </td>
            <td>
                @Html.DisplayFor(model => item.description)
            </td>
                <td>
                    @{
                        var lookup = (Dictionary<int, string>)ViewBag.NameLookup;
                        var parentName = item.parentId != null && lookup.ContainsKey(item.parentId.Value)
                        ? lookup[item.parentId.Value] : "—";
                    }
                    @parentName
                </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
